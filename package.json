{
  "name": "stratemark-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8085 tsx src/index.ts",
    "dev:cloud-run": "bash scripts/run-cloud-run-local.sh",
    "emulator:firestore": "gcloud emulators firestore start --host-port=127.0.0.1:8085",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outdir=dist --external:express --external:@google-cloud/firestore --external:firebase-admin --external:resend --external:stripe --external:cors --external:dotenv",
    "start": "node dist/index.js",
    "deploy": "gcloud run deploy stratemark-backend --source . --region us-central1 --allow-unauthenticated",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.18.0",
    "firebase-admin": "^14.2.0",
    "resend": "^4.0.0",
    "stripe": "^17.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.24.2",
    "supertest": "^7.2.2",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
